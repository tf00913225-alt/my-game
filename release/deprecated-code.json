{
  "schemaVersion": 1,
  "scanRoots": ["index.html", "js", "css"],
  "extensions": [".html", ".js", ".css"],
  "assertions": [
    {
      "id": "DEP-001-patrol-power-saving",
      "description": "巡怪省電模式已正式廢除；DOM、class、handler、設定 key 與顯示文字不得留在正式程式碼。",
      "enabled": true,
      "forbidden": [
        "quickPowerSavingToggle",
        "v17361-power-save-toggle",
        "v17361TogglePowerSaving",
        "V17361_POWER_SAVE_KEY",
        "v17361_patrol_power_saving",
        "v17361PowerSavingEnabled",
        "v17361RequestWakeLock",
        "v17361ReleaseWakeLock",
        "省電 OFF"
      ]
    },
    {
      "id": "DEP-002-gameplay-center-navigation",
      "description": "底部舊 BOSS 入口與副本頁深淵入口已正式廢除；玩家只能由玩法中心進入 BOSS、四象塔與深淵。",
      "enabled": true,
      "forbidden": [
        "id=\"dungeonTabBtnAbyss\"",
        "src=\"assets/ui/nav-boss.png\"",
        "aria-label=\"BOSS\"",
        "<span class=\"nav-sr-only\">BOSS</span>"
      ]
    },
    {
      "id": "DEP-003-legacy-boot-runtime-and-patrol-loaders",
      "description": "舊 artificial startup gate、full-runtime input gate、未登入本機繞過與 Base64 巡怪 chunk 已正式退役，不得回到 production HTML/JS/CSS。",
      "enabled": true,
      "forbidden": [
        "MIN_DURATION_MS",
        "MAX_DURATION_MS",
        "TOTAL_RUNTIME_MODULES",
        "__v173ReportRuntimeProgress",
        "__v17347RuntimeGate",
        "loadVersionedRuntimePatchesInOrder",
        "v131-patrol-sprite-",
        "data:image/webp;base64",
        "先使用本機存檔",
        "DEV_AUTH_BYPASS"
      ]
    }
  ]
}
