{
  "schemaVersion": 1,
  "scanRoots": [
    "index.html",
    "js",
    "css"
  ],
  "extensions": [
    ".html",
    ".js",
    ".css"
  ],
  "assertions": [
    {
      "id": "DEP-001-patrol-power-saving",
      "description": "巡怪省電模式已正式廢除；DOM、class、handler、設定 key 與顯示文字不得留在正式程式碼。",
      "enabled": true,
      "forbidden": [
        "quickPowerSavingToggle",
        "v17361-power-save-toggle",
        "v17361TogglePowerSaving",
        "V17361_POWER_SAVE_KEY",
        "v17361_patrol_power_saving",
        "v17361PowerSavingEnabled",
        "v17361RequestWakeLock",
        "v17361ReleaseWakeLock",
        "省電 OFF"
      ]
    },
    {
      "id": "DEP-002-gameplay-center-navigation",
      "description": "底部舊 BOSS 入口與副本頁深淵入口已正式廢除；玩家只能由玩法中心進入 BOSS、四象塔與深淵。",
      "enabled": true,
      "forbidden": [
        "id=\"dungeonTabBtnAbyss\"",
        "src=\"assets/ui/nav-boss.png\"",
        "aria-label=\"BOSS\"",
        "<span class=\"nav-sr-only\">BOSS</span>"
      ]
    },
    {
      "id": "DEP-003-legacy-boot-runtime-and-patrol-loaders",
      "description": "舊 artificial startup gate、full-runtime input gate、未登入本機繞過與 Base64 巡怪 chunk 已正式退役，不得回到 production HTML/JS/CSS。",
      "enabled": true,
      "forbidden": [
        "MIN_DURATION_MS",
        "MAX_DURATION_MS",
        "TOTAL_RUNTIME_MODULES",
        "__v173ReportRuntimeProgress",
        "__v17347RuntimeGate",
        "loadVersionedRuntimePatchesInOrder",
        "v131-patrol-sprite-",
        "data:image/webp;base64",
        "先使用本機存檔",
        "DEV_AUTH_BYPASS"
      ]
    },
    {
      "id": "DEP-004-boss-function-card-and-root-hit-frame",
      "description": "Boss 功能卡平行目標系統與 root red-hit 卡框已正式退役；正式程式只允許數字 enemy target entity 與立繪受擊回饋。",
      "enabled": true,
      "forbidden": [
        "MECH_L",
        "MECH_C",
        "MECH_R",
        "boss-mechanism-card",
        "boss-mechanism-slot",
        "mechanism:",
        "blockingShield",
        "mandatoryMechanismTarget",
        "resolveMechanismAction",
        ".red-hit"
      ]
    },
    {
      "id": "DEP-005-frostbite-skill-lock-ui",
      "description": "凍傷是傷害、閃避與異常抗性各降低 25% 的 soft debuff，不得再禁止玩家或怪物使用技能，也不得顯示舊禁止文字。",
      "enabled": true,
      "forbidden": [
        "v152-frostbite-blocked",
        "凍傷禁止使用技能",
        "rejectFrostbittenSkill",
        "withoutLegacyFrostbiteLock",
        "v169FrostbiteCompatibilityActive"
      ]
    },
    {
      "id": "DEP-006-persistent-status-frame-renderer",
      "description": "持續狀態逐幀 Sprite renderer、V153 狀態節點與舊燃燒/冰封卡片覆蓋層已正式退役；持續狀態只能由 V143 low-motion status visual owner 顯示。",
      "enabled": true,
      "forbidden": [
        "v143StatusRasterFrames",
        "v153-status-vfx",
        "v143StatusSpriteManifest",
        "v143SyncStatusSpriteEffects",
        "function statusSheet(",
        "card-status-overlay",
        "battleMonsterFreezeOverlay",
        "battleMonsterBurnOverlay",
        "freezeOverlayShimmer",
        "burnOverlayFlicker"
      ]
    },
    {
      "id": "DEP-007-tower-element-large-boss-legacy-owners",
      "description": "四象塔元素重洗、Tower 大型 Boss object/summon plan 與 V152 極帝名稱式技能 dispatcher 已退休；正式 Runtime 必須使用 Tower Owner、V144 Element Guard 與 Personal/World Large Boss 邊界。",
      "enabled": true,
      "forbidden": [
        "rebalanceDungeonElements",
        "towerObjectPlan",
        "towerSummonPlan",
        "v152ResolveExtremeEmperorAction"
      ]
    },
    {
      "id": "DEP-008-inventory-skill-battle-owner-convergence",
      "description": "背包、技能頁與戰鬥技能選擇器不得回到已退休的多 Owner、重複成本、Dungeon 專用幾何或裁切文字模式。",
      "enabled": true,
      "forbidden": [
        "v169-dungeon-inventory-overlay",
        "maximizeDungeonBackpack",
        "v138-skill-learn-cost",
        "decorateSkillRows",
        "decorateSkillProgressionUi",
        "normalizeSkillActionCards",
        "sq-description",
        "v131-skill-kind",
        "map-inventory-overlay-open",
        "skill-section-learned",
        "skill-section-unlearned",
        "buildSkillSectionDivider",
        "renderSkillLoadout=function",
        "max-height:12px !important"
      ]
    },
    {
      "id": "DEP-009-hit-evasion-percent-v2",
      "description": "退休舊 Accuracy 換算係數与等級派生怪物閃避 owner；僅裝備資料遷移容許歷史值換算。",
      "enabled": true,
      "forbidden": [
        "HIT_CHANCE_ACCURACY_COEFFICIENT",
        "DEFAULT_MONSTER_EVASION_PER_LEVEL",
        "DEFAULT_MONSTER_EVASION_CAP",
        "getDefaultMonsterEvasion",
        "accuracy *=",
        "accuracy*=(1-",
        "Math.min(85, evasion)",
        "copy.evasion=numeric(copy.evasion)+mod.evasionPercent"
      ]
    },
    {
      "id": "DEP-FORGE-BESTIARY-20261002",
      "description": "可見圖鑑入口與 renderer 已被鍛造替換；擊殺資料仍屬冒險正式 owner。",
      "enabled": true,
      "forbidden": [
        "homeIconBestiary",
        "renderBestiaryContent",
        "openHomeFeature('bestiary')"
      ]
    },
    {
      "id": "DEP-MONSTER-BALANCE-P2A-WILD-20261003",
      "description": "Wild 舊數值 Owner、Zone strength、core halving 與專用 mutation markers 已實體退休；不得回到正式程式。非 Wild legacy builder 另有明確相容邊界。",
      "enabled": true,
      "forbidden": [
        "strengthenMonster",
        "strengthenAllZoneMonsters",
        "strengthenNewWildMonster",
        "halveMonsterCoreStats",
        "_v131StrengthApplied",
        "v17342BeginnerStatsHalved",
        "V173_32_WILD_ZONE_STRENGTHS",
        "v173WildZoneStrengthMultipliers"
      ]
    },
    {
      "id": "DEP-MONSTER-P2B-DAILY-SCALING",
      "description": "Daily core rescaling, pre-render normalizer and inactive Equipment builder are retired. V132 common builder is non-Daily compatibility only.",
      "enabled": true,
      "forbidden": [
        "DAILY_DUNGEON_SCALE_FIELDS",
        "DAILY_DUNGEON_DIFFICULTY_MULTIPLIER",
        "normalizeDailyDungeonMonster",
        "getDailyDungeonScaleContext",
        "v158PrepareBattleRender",
        "EQUIPMENT_DUNGEON_ELITE_MULTIPLIERS",
        "EQUIPMENT_DUNGEON_BOSS_MULTIPLIERS",
        "applyEquipmentDungeonRankStrength",
        "buildEquipmentDungeonMonster",
        "buildEquipmentDungeonRoster"
      ]
    }
  ]
}
