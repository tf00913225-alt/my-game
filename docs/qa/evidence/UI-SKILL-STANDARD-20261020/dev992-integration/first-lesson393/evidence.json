                ],
                "next": "c1_03",
                "x": 24.8,
                "y": 70.5,
                "tutorialEncounterId": "tutorial_2",
                "guidance": [
                  {
                    "speaker": "npc",
                    "name": "守驛人",
                    "text": "這個惡徒比先前的難纏，只靠硬拚恐怕不成。"
