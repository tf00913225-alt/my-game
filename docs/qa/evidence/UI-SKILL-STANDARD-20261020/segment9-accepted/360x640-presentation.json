ure-items.cf197e72837f.js"],"entries":[{"type":"exp","action":"v148ShowDailyDungeonPreview('exp')"},{"type":"material","action":"v148ShowDailyDungeonPreview('material')"},{"type":"gold","action":"v148ShowDailyDungeonPreview('gold')"},{"type":"equipment","action":"v17346ShowEquipmentDungeonPreview()"}],"actions":[{"type":"exp","action":"v148ShowDailyDungeonPreview('exp')","end":{"top":0,"height":1788,"client":1788,"returnInside":true,"text":"日常副本\n經驗副本獎勵預覽\n共用經驗池\nEXP\n\n通關所得經驗直接存入共用經驗池，不綁定單一角色，可自由分配給隊伍角色。\n\n結算方式\n\n完成副本後直接結算；若該結算提供廣告加倍，可自行選擇是否加倍領取。\n\n共用經驗可於角色頁分配，用於角色升級。\n返回"}},{"type":"material","action":"v148ShowDailyDungeonPreview('material')","end":{"top":0,"height":1788,"client":1788,"returnInside":true,"text":"日常副本\n材料副本獎勵預覽\n材料寶箱\n×1～3\n\n通關回合越少，取得寶箱數越高；寶箱內含白／藍／紫／橙階礦石、基礎／30%／50%補品及還魂丹；分布暫定。\n\n用途\n\n礦石可用於冶煉與礦石升階；補品與還魂丹供戰鬥使用。裝備設計圖已取消。\n\n寶箱數量依副本結算規則決定。\n返回"}},{"type":"gold","action":"v148ShowDailyDungeonPreview('gold')","end":{"top":0,"height":1788,"client":1788,"returnInside":true,"text":"日常副本\n金幣副本獎勵預覽\n金幣獎勵\n金幣\n\n依目前副本難度與結算規則獲得金幣，通關後直接入帳。\n\n加倍選項\n\n若結算提供廣告加倍，可選擇觀看廣告取得加倍金幣，不影響直接領取。\n\n金幣數量依目前副本難度與結算結果決定。\n返回"}},{"type":"equipment","action":"v17346ShowEquipmentDungeonPreview()","end":{"top":0,"height":1788,"client":1788,"returnInside":true,"text":"日常副本\n裝備副本獎勵預覽\n裝備寶箱\n×2\n\n勝利後取得 2 個裝備寶箱；每個寶箱固定隨機取得 3 件裝備。\n\n元素系列碎片\n隨機一種 ×10\n\n赤炎／寒泉／岩岳／青嵐等機率；暫定，每種25%；廣告雙倍亦適用。\n\n裝備品階機率\n\n白階50%　・　藍階35%　・　紫階10%　・　橙階5%\n\n裝備品階機率依正式裝備寶箱掉落表顯示。\n返回"}}],"metrics":[{"type":"exp","width":328,"title":"經驗副本獎勵預覽","fonts":[15,15],"border":"url(\"http://127.0.0.1:55709/assets/ui/skill-iron-bronze/panel.827d9ba9a6f8.webp\")"},{"type":"material","width":328,"title":"材料副本獎勵預覽","fonts":[15,15],"border":"url(\"http://127.0.0.1:55709/assets/ui/skill-iron-bronze/panel.827d9ba9a6f8.webp\")"},{"type":"gold","width":328,"title":"金幣副本獎勵預覽","fonts":[15,15],"border":"url(\"http://127.0.0.1:55709/assets/ui/skill-iron-bronze/panel.827d9ba9a6f8.webp\")"},{"type":"equipment","width":328,"title":"裝備副本