                "dialogue": [
                  {
                    "speaker": "npc",
                    "name": "守驛人",
                    "text": "少俠，前頭有個攔路的。先看準敵人，再穩穩出招。"
                  },
                  {
                    "speaker": "player",
                    "name": "玩家",
                    "text": "我初來此地，正想問問山路的情況。"
                  },
                  {
                    "speaker": "npc",
                    "name": "守驛人",
                    "text": "先過了眼前這一關。別慌，一招一式來。"
