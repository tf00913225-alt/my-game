<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/poc_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Headline"
            android:textColor="@color/title_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/poc_description"
            android:textColor="@color/body_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/facebookLoginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="48dp"
            android:text="@string/facebook_login_action" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/initializing"
            android:textColor="@color/status_ok"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/firebase_uid_label"
            android:textColor="@color/body_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/uidText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/uid_panel"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:text="@string/uid_not_signed_in"
            android:textColor="@color/uid_text"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <Button
            android:id="@+id/clearPocSessionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:text="@string/clear_poc_session" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/poc_data_boundary"
            android:textColor="@color/body_text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
